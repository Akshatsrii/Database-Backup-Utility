datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Connection {
  id        String   @id @default(uuid())
  name      String
  type      String   // mysql, postgres, mongodb, sqlite
  host      String?
  port      Int?
  username  String?
  password  String?
  database  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
